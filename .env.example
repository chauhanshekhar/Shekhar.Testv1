# Copy this file to .env (gitignored) and fill in real values.
# docker-compose.yml reads MSSQL_SA_PASSWORD from here.
MSSQL_SA_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# ── Groww broker credentials ─────────────────────────────────────────────────
# Generated ONCE on the Groww Cloud API Keys page — these are NOT daily values.
# Only the approval click and the derived access token are daily; the worker
# handles the token itself (GrowwTokenRefreshWorker).
#
# QUOTE the values. A '#' in an unquoted .env value starts a comment and the
# rest is silently discarded, which shows up later as a confusing auth failure.
GROWW_API_KEY='REPLACE_WITH_API_KEY'

# Base32 secret from the authenticator enrolment (used to generate the TOTP code).
GROWW_TOTP_SECRET='REPLACE_WITH_BASE32_TOTP_SECRET'

# NEVER commit the real .env. If a credential is ever pasted anywhere public,
# revoke it on the Groww Cloud API Keys page and generate a new one.
