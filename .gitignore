# appsettings.Development.json is safe (dev keys only)
# The file below should be created locally and NEVER committed:
appsettings.Local.json
appsettings.*.Local.json
secrets.json
appsettings.json
appsettings.Production.json
!appsettings.json.example
!appsettings.Production.json.example

